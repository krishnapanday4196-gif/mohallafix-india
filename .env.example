# ========================================================================
# MOHALLAFIX INDIA - ENVIRONMENT CONFIGURATION
# ========================================================================

# Supabase Production Database & Auth
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Python FastAPI AI Backend URL
NEXT_PUBLIC_AI_BACKEND_URL=http://localhost:8000

# Base URL for Next.js App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notification Service Providers (Optional)
# If left blank or unconfigured, the system explicitly reports them as NOT CONFIGURED
RESEND_API_KEY=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=

# AI Model Configuration (Optional Gemini key for enhanced multimodal civic analysis)
GEMINI_API_KEY=

